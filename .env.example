# ─────────────────────────────────────────────
# DGX Stack Configuration
# Copy to .env and edit, or run ./setup.sh
# ─────────────────────────────────────────────

# Two vLLM instances share the DGX Spark's 128GB unified memory:
#   LLM  — Qwen 3.6 35B MoE (3B active), NVIDIA NVFP4, ~23GB, port 8000
#   OCR  — dots.mocr document-parsing VLM (~3B), FP8, ~5GB, port 8001
# Memory budget: qwen ~60GB (weights + KV at util 0.4) + mocr ~13GB
# (weights + fixed 8GB KV) leaves ~50GB for the OS and OCR service.
# vLLM image: the v0.25.1 release branch built for ARM64 + CUDA 13
# (required for the Spark's Grace CPU + GB10). vLLM publishes no plain
# v0.25.1 arm64/cu13 tag; this pinned build is the v0.25.1 tag plus two
# release-branch commits. The upstream vllm/vllm-openai image is the
# one both vLLM's DGX Spark guide and NVIDIA's model card recommend —
# the NGC vLLM container is NOT required (and is known to fail on this
# checkpoint).
VLLM_IMAGE="vllm/vllm-openai:vllm-arm64-cu13-0.25.1-7a33ba9"

# ── LLM: Qwen 3.6 35B NVFP4 (multimodal chat; open access) ──
HF_MODEL_ID="nvidia/Qwen3.6-35B-A3B-NVFP4"
SERVED_MODEL_NAME="qwen3.6-35b"

# Performance flags (based on NVIDIA's recommended DGX Spark serve
# command for this checkpoint):
#   --attention-backend flashinfer   attention kernels for Blackwell
#   --moe-backend marlin             NVFP4 MoE path on SM12.1
#   --enable-chunked-prefill         overlap prefill with decode
#   --async-scheduling               hide scheduler latency
#   --load-format fastsafetensors    faster weight loading at startup
#   --no-enable-prefix-caching       REQUIRED with MTP on this hybrid
#       model: prefix caching + speculative decoding corrupts the
#       recurrent-attention state on cache hits (vLLM issue #43559,
#       fix not in 0.25.1). Re-enable only if you set
#       VLLM_SPECULATIVE_TOKENS=0.
VLLM_EXTRA_FLAGS="--no-enable-prefix-caching --reasoning-parser qwen3 --tool-call-parser qwen3_xml --enable-auto-tool-choice --attention-backend flashinfer --moe-backend marlin --enable-chunked-prefill --async-scheduling --load-format fastsafetensors"

# MTP speculative decoding: the model ships a 1-layer multi-token
# prediction head; vLLM drafts N tokens per step and the base model
# verifies every draft, so the output distribution is unchanged.
# Measured on DGX Spark: ~76.7 tok/s bare -> ~108 tok/s with 3 draft
# tokens. 0 disables.
VLLM_SPECULATIVE_TOKENS=3

# Serve-time default for the Qwen thinking toggle. Off by default —
# requests opt in with chat_template_kwargs: {"enable_thinking": true}.
VLLM_ENABLE_THINKING_DEFAULT=false

# ── OCR model: dots.mocr (rednote-hilab), served as a second vLLM
# instance. binedge/dots.mocr-FP8 is the memory-efficient quant
# (~4.8GB vs 6.1GB BF16; vision tower kept unquantized — only the
# language model is FP8). Fallback: rednote-hilab/dots.mocr (BF16).
MOCR_MODEL_ID="binedge/dots.mocr-FP8"
MOCR_SERVED_MODEL_NAME="dots-mocr"
MOCR_PORT=8001
MOCR_GPU_MEMORY_UTIL=0.10
MOCR_MAX_MODEL_LEN=32768
MOCR_MAX_NUM_SEQS=12
MOCR_MAX_NUM_BATCHED_TOKENS=16384
MOCR_KV_CACHE_DTYPE=auto
# --chat-template-content-format string is required for dots.mocr's
# chat template (per the official serving instructions).
# --kv-cache-memory-bytes gives this instance a fixed 8GB KV cache:
# on unified memory, vLLM's gpu-memory-utilization budget counts ALL
# system usage (including the Qwen instance's ~51GB), so a small
# fractional budget would be consumed before this instance allocates
# anything. An explicit byte size is immune to that.
MOCR_VLLM_EXTRA_FLAGS="--enable-prefix-caching --enable-chunked-prefill --chat-template-content-format string --kv-cache-memory-bytes 8589934592"

# HuggingFace (optional — model is open access)
HF_TOKEN=
HF_CACHE=~/.cache/huggingface

# Offline / air-gapped operation. 0 = normal (allows the one-time model
# download on first deploy). After the first successful deploy the weights
# and remote code are cached locally; set HF_OFFLINE=1 and redeploy to
# forbid all Hugging Face network calls, so both vLLM instances load purely
# from cache and the stack boots with no internet at all. Do NOT set 1
# before the models have been downloaded once.
HF_OFFLINE=0

# Network
VLLM_PORT=8000
OCR_PORT=8010

# Docker bridge network for this stack. Default stays in 10.10.x.x to
# avoid the Docker default 172.16.0.0/12 pool. Change the /24 if it
# collides with another network or host route on the DGX.
DGX_NET_SUBNET=10.10.99.0/24
DGX_NET_GATEWAY=10.10.99.1

# GPU / Model — NVIDIA recommends 0.4 utilization on DGX Spark for this
# checkpoint: ~23GB weights + KV cache fit easily in 0.4 × 128GB, and
# the hybrid linear-attention design keeps the KV cache small even at
# the full 262K context. Together with the mocr instance this leaves
# ~50GB for the OS and the OCR service container.
GPU_MEMORY_UTIL=0.4
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=12
MAX_NUM_BATCHED_TOKENS=8192
# KV cache: auto (BF16) by default. fp8 doubles KV capacity but caused
# intermittent CUDA illegal-memory-access engine crashes under mixed
# concurrent load on SM12.1 (FlashInfer FP8 KV kernels) — only switch
# back if you need >5x full-context concurrency and accept the risk.
KV_CACHE_DTYPE=auto

# OCR service (dots.mocr processes exactly one page per request).
# 200 DPI is the dots.mocr team's recommended PDF rendering resolution.
OCR_DPI=200
OCR_MAX_TOKENS=16384
OCR_TEMPERATURE=0.1
OCR_TOP_P=0.9
OCR_MAX_CONCURRENT_PAGES=12
OCR_MAX_RETRIES=2
OCR_MAX_PAGES=200
OCR_MAX_FILE_SIZE_MB=100
